# ─── Node.js dependencies ──────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json  # optional – many devs commit this, but if you prefer, you can keep it. Usually keep it.
yarn.lock          # optional
pnpm-lock.yaml     # optional

# ─── Environment variables (secrets) ──────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.development

# ─── Build outputs ─────────────────────────────────────────────
dist/
build/
.out/
*.tsbuildinfo

# ─── Uploaded files (if stored locally) ──────────────────────
uploads/
temp/
storage/

# ─── Credentials / OAuth tokens ──────────────────────────────
credentials.json
token.json
*.pem
*.key
*.crt

# ─── Logs ──────────────────────────────────────────────────────
logs/
*.log

# ─── OS / Editor files ─────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-*

# ─── Test coverage ─────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Database / SQL dumps ──────────────────────────────────────
*.sql
*.sql.gz
*.dump

# ─── Misc cache ────────────────────────────────────────────────
.cache/
.parcel-cache/
.eslintcache
.prettiercache

# ─── Backend specific ──────────────────────────────────────────
# (if your backend is in a subfolder, adjust accordingly)
backend/node_modules/
backend/.env
backend/uploads/

# ─── Frontend specific (if in subfolder) ──────────────────────
frontend/dist/
frontend/node_modules/
frontend/.env